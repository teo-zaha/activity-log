# GitLab
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_USER=your-gitlab-username

# Jira (Atlassian)
JIRA_URL=https://jira.example.com
JIRA_TOKEN=your-jira-access-token
JIRA_INSECURE=true

# Optional: comma-separated absolute repo paths or parent folders to scan
# Leave empty to default to your OS home directory
GIT_DIRS=

# Windows only. Folders per WSL distribution as a JSON object, read like GIT_DIRS:
# a repository, or a folder searched for them (4 levels deep). `~` is the distribution's home.
# Leave empty to search the home of every distribution; `{}` searches none.
# e.g. WSL_GIT_DIRS='{"NixOS":["~/trn","/srv/tools"],"Ubuntu":["~"]}'
WSL_GIT_DIRS=
