# Sources (GitLab, Jira, Git folders, calendars) live in config.toml, not here: add them in the
# desktop app or with `activity-log sources add <kind>`; `activity-log config path` prints the file.

# Optional: a config file other than the default one
ACTIVITY_LOG_CONFIG=

# Optional: API server port (default 3000)
PORT=

# Optional: minutes recent GitLab/Jira days stay cached (default 5)
CACHE_TTL_MINUTES=

# Optional: per-day cache directory (default: the OS cache directory)
ACTIVITY_LOG_CACHE_DIR=
