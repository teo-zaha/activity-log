# GitLab
GITLAB_URL=https://git.inform-software.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_USER=your-gitlab-username

# Jira (Atlassian)
JIRA_URL=https://jira.inform-software.com
JIRA_TOKEN=your-jira-access-token
JIRA_INSECURE=true

# Optional: comma-separated absolute repo paths or parent folders to scan
# Leave empty to default to your OS home directory
GIT_DIRS=

# Windows only. WSL distributions whose $HOME is searched (4 levels deep).
# Leave empty to search every distribution; `wsl -l -q` lists them.
WSL_DISTROS=

# Windows only. WSL repositories as "Distro:/absolute/linux/path", comma-separated.
# e.g. WSL_GIT_DIRS=NixOS:/home/nixos/trn/atlas,NixOS:/home/nixos/projects/stitch-lab
WSL_GIT_DIRS=
