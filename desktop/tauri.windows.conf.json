{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Activity Log",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 620,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "installer/installer.ico",
        "uninstallerIcon": "installer/installer.ico"
      }
    }
  }
}
