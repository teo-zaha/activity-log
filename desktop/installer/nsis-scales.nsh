; Generated by generate-images.py from its CONTROLS table: do not edit, run the script.
; ACTIVITY_LOG_IMAGES is the folder of these bitmaps (hooks.nsh defines it).

!macro ACTIVITY_LOG_HEADER_FOR WIDTH HEIGHT TARGET RESULT
  StrCpy ${RESULT} 0
  ${If} ${WIDTH} >= 500
  ${AndIf} ${HEIGHT} >= 197
    !pragma verifyloadimage "${ACTIVITY_LOG_IMAGES}/nsis-header-350.bmp"
    File "/oname=${TARGET}" "${ACTIVITY_LOG_IMAGES}/nsis-header-350.bmp"
    StrCpy ${RESULT} 1
  ${ElseIf} ${WIDTH} >= 450
  ${AndIf} ${HEIGHT} >= 171
    !pragma verifyloadimage "${ACTIVITY_LOG_IMAGES}/nsis-header-300.bmp"
    File "/oname=${TARGET}" "${ACTIVITY_LOG_IMAGES}/nsis-header-300.bmp"
    StrCpy ${RESULT} 1
  ${ElseIf} ${WIDTH} >= 375
  ${AndIf} ${HEIGHT} >= 144
    !pragma verifyloadimage "${ACTIVITY_LOG_IMAGES}/nsis-header-250.bmp"
    File "/oname=${TARGET}" "${ACTIVITY_LOG_IMAGES}/nsis-header-250.bmp"
    StrCpy ${RESULT} 1
  ${ElseIf} ${WIDTH} >= 325
  ${AndIf} ${HEIGHT} >= 127
    !pragma verifyloadimage "${ACTIVITY_LOG_IMAGES}/nsis-header-225.bmp"
    File "/oname=${TARGET}" "${ACTIVITY_LOG_IMAGES}/nsis-header-225.bmp"
    StrCpy ${RESULT} 1
  ${ElseIf} ${WIDTH} >= 300
  ${AndIf} ${HEIGHT} >= 109
    !pragma verifyloadimage "${ACTIVITY_LOG_IMAGES}/nsis-header-200.bmp"
    File "/oname=${TARGET}" "${ACTIVITY_LOG_IMAGES}/nsis-header-200.bmp"
    StrCpy ${RESULT} 1
  ${ElseIf} ${WIDTH} >= 250
  ${AndIf} ${HEIGHT} >= 101
    !pragma verifyloadimage "${ACTIVITY_LOG_IMAGES}/nsis-header-175.bmp"
    File "/oname=${TARGET}" "${ACTIVITY_LOG_IMAGES}/nsis-header-175.bmp"
    StrCpy ${RESULT} 1
  ${ElseIf} ${WIDTH} >= 225
  ${AndIf} ${HEIGHT} >= 83
    !pragma verifyloadimage "${ACTIVITY_LOG_IMAGES}/nsis-header-150.bmp"
    File "/oname=${TARGET}" "${ACTIVITY_LOG_IMAGES}/nsis-header-150.bmp"
    StrCpy ${RESULT} 1
  ${ElseIf} ${WIDTH} >= 175
  ${AndIf} ${HEIGHT} >= 70
    !pragma verifyloadimage "${ACTIVITY_LOG_IMAGES}/nsis-header-125.bmp"
    File "/oname=${TARGET}" "${ACTIVITY_LOG_IMAGES}/nsis-header-125.bmp"
    StrCpy ${RESULT} 1
  ${EndIf}
!macroend

