{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Activity Log",
  "version": "0.1.0",
  "identifier": "com.activitylog.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../dashboard run dev:tauri",
    "beforeBuildCommand": "pnpm --dir ../dashboard run build:tauri",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dashboard/dist/dashboard/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Activity Log",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 620,
        "acceptFirstMouse": true,
        "resizable": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
